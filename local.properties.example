# Copy this file to local.properties and fill in your values.
# local.properties is gitignored and must never be committed.
#
# Optional: these are only DEFAULT values, baked into DEBUG builds only.
# Release builds never embed them (their APKs are published on a public repository):
# the server URL, API key and device ID are set from the app's settings screen.

# API key for authenticating with the Socket.IO server
API_KEY=your_api_key_here

# Socket.IO server URL
API_URL=https://your-server.example.com
